# Copy to .env; never commit real credentials.
NODE_ENV=development
APP_ORIGIN=https://ops.example.com
DATABASE_URL=postgresql://pipkerops:CHANGE_ME@localhost:5432/pipkerops?sslmode=disable
REDIS_URL=redis://:CHANGE_ME@localhost:6379/0
ALLOW_INSECURE_BACKENDS=false
BOOTSTRAP_EMAIL=admin@example.com
BOOTSTRAP_PASSWORD=CHANGE_ME_USE_AT_LEAST_16_RANDOM_CHARACTERS
BOOTSTRAP_NAME=管理员
GATEWAY_HOST=0.0.0.0
ENROLL_PORT=9444
GATEWAY_PORT=9443
GATEWAY_PUBLIC_URL=wss://ops.example.com:9443/agent
ENROLL_PUBLIC_URL=https://ops.example.com:9444
PKI_DIR=./.data/pki
BACKUP_DIR=./.data/backups
PKI_HOSTS=localhost,127.0.0.1,ops.example.com
WORKER_INTERVAL_MS=2000
# Optional custom Gateway PEM paths (defaults to PKI_DIR/server.crt and server.key)
# GATEWAY_TLS_CERT=./.data/pki/server.crt
# GATEWAY_TLS_KEY=./.data/pki/server.key
