# Docker 部署参数；修改后执行“重启”。应用凭据另见 config/ops/app.conf。
COMPOSE_PROJECT_NAME=pipkerops
PIPKEROPS_IMAGE=ghcr.io/holic512/pipkerops
PIPKEROPS_VERSION=0.1.4
# 修改镜像后先重新安装（准备镜像），再启动；国内源另见 mirrors.conf。
PIPKEROPS_PROXY_IMAGE=nginx:1.28-alpine-slim
# 默认仅供同机 HTTPS 反向代理接入；不要把裸 HTTP 后端暴露到公网。
# 其他容器内的代理需要使用可达宿主地址，并通过网络隔离限制入口。
WEB_BIND=127.0.0.1
WEB_PORT=8080
