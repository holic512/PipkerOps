# =======================
# 容器部署（应用凭据请填写 config/app.conf）
# =======================
COMPOSE_PROJECT_NAME=pipkerops
PIPKEROPS_IMAGE=ghcr.io/holic512/pipkerops
PIPKEROPS_VERSION=latest
# =======================
# 宿主路径（相对仓库根目录或绝对路径）
# =======================
PIPKEROPS_CONFIG_DIR=./deploy/config
PIPKEROPS_DATA_DIR=./deploy/data
WEB_TLS_DIR=./deploy/certs/web
# =======================
# 对外监听
# =======================
WEB_BIND=0.0.0.0
WEB_PORT=443
GATEWAY_BIND=0.0.0.0
GATEWAY_PORT=9443
ENROLL_PORT=9444
