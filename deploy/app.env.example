# Copied to deploy/config/app.env. Never commit real credentials.
# Node env-file syntax: literal values, no ${VAR} expansion. URL-encode passwords.
APP_ORIGIN=https://ops.example.com
DATABASE_URL=postgresql://pipkerops:CHANGE_ME@10.0.0.10:5432/pipkerops?sslmode=disable
REDIS_URL=redis://:CHANGE_ME@10.0.0.11:6379/1
BOOTSTRAP_EMAIL=admin@example.com
BOOTSTRAP_PASSWORD=CHANGE_ME_USE_AT_LEAST_16_RANDOM_CHARACTERS
BOOTSTRAP_NAME=管理员
GATEWAY_PUBLIC_URL=wss://ops.example.com:9443/agent
ENROLL_PUBLIC_URL=https://ops.example.com:9444
PKI_HOSTS=ops.example.com
# Container paths/ports are fixed by compose.yaml.
PKI_DIR=/app/.data/pki
BACKUP_DIR=/app/.data/backups
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=9443
ENROLL_PORT=9444
WORKER_INTERVAL_MS=2000
# For a private backend CA, mount its PEM inside config/ and set:
# NODE_EXTRA_CA_CERTS=/app/config/backend-ca.pem
