# 应用文本配置：键=值；支持引号，不执行脚本或变量替换。密码直接填写原文，无需 URL 编码。

# =======================
# 数据库
# =======================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME="pipkerops"
DATABASE_PASSWORD="CHANGE_ME"
DATABASE_NAME=pipkerops
DATABASE_SSL_MODE=disable
# DATABASE_CA_FILE=/app/config/database-ca.pem

# =======================
# 缓存 Redis
# =======================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=""
REDIS_PASSWORD="CHANGE_ME"
REDIS_DATABASE=0
REDIS_TLS=false
# REDIS_CA_FILE=/app/config/redis-ca.pem

# =======================
# 应用与安全
# =======================
APP_ORIGIN=https://ops.example.com
ALLOW_INSECURE_BACKENDS=false

# =======================
# 初始管理员
# =======================
BOOTSTRAP_EMAIL=admin@example.com
BOOTSTRAP_PASSWORD="CHANGE_ME_USE_AT_LEAST_16_RANDOM_CHARACTERS"
BOOTSTRAP_NAME=管理员

# =======================
# 网关
# =======================
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=9443
ENROLL_PORT=9444
GATEWAY_PUBLIC_URL=wss://ops.example.com:9443/agent
ENROLL_PUBLIC_URL=https://ops.example.com:9444

# =======================
# 证书与持久目录
# =======================
PKI_DIR=./.data/pki
BACKUP_DIR=./.data/backups
PKI_HOSTS=localhost,127.0.0.1,ops.example.com

# =======================
# 后台任务
# =======================
WORKER_INTERVAL_MS=2000
