# 应用文本配置：键=值；支持引号，不执行脚本或变量替换。密码直接填写原文，无需 URL 编码。
# 修改后执行“重启”；首次安装后先填写数据库、Redis 和初始管理员，再单独启动。

# =======================
# 数据库
# =======================
# 地址应能从 Ops 容器访问；同机数据库可用 host.docker.internal。
DATABASE_HOST=host.docker.internal
DATABASE_PORT=5432
DATABASE_USERNAME="pipkerops"
DATABASE_PASSWORD="CHANGE_ME"
DATABASE_NAME=pipkerops
# 是否使用 TLS 完全由此设置决定；生产环境也支持 disable。
DATABASE_SSL_MODE=disable
# DATABASE_CA_FILE=/app/config/database-ca.pem

# =======================
# 缓存 Redis
# =======================
# 使用独立逻辑库；ACL 用户名不需要时留空。
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_USERNAME=""
REDIS_PASSWORD="CHANGE_ME"
REDIS_DATABASE=0
# 生产环境也支持 false；启用 TLS 时可指定 CA。
REDIS_TLS=false
# REDIS_CA_FILE=/app/config/redis-ca.pem

# =======================
# 初始管理员
# =======================
# 仅在管理员不存在时初始化；后续重启不会重置账号。
BOOTSTRAP_EMAIL=admin@example.com
BOOTSTRAP_PASSWORD="CHANGE_ME_USE_AT_LEAST_16_RANDOM_CHARACTERS"
BOOTSTRAP_NAME=管理员

# =======================
# 持久目录
# =======================
# 容器内路径由部署挂载提供，一般无需修改。
NODE_CREDENTIALS_DIR=./.data/credentials
RELEASE_CACHE_DIR=./.data/releases
BACKUP_DIR=./.data/backups

# =======================
# 后台任务
# =======================
# Worker 调度间隔，单位毫秒。
WORKER_INTERVAL_MS=2000
