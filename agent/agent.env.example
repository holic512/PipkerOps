# Private environment file: <deployRoot>/config/agent/agent.env (0600).
PIPKEROPS_LISTEN=0.0.0.0:9443
# A directly reachable HTTPS origin; IP addresses are supported.
PIPKEROPS_URL=https://192.168.1.10:9443
PIPKEROPS_NAME=linux-node-01
PIPKEROPS_DEPLOY_ROOT=/opt/pipkerops
PIPKEROPS_STATE_DIR=/opt/pipkerops/data/agent
