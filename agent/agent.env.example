# Place a private copy at /etc/pipkerops/agent.env, mode 0600.
PIPKEROPS_GATEWAY=wss://ops.example.com:9443/agent
PIPKEROPS_ENROLL_URL=https://ops.example.com:9444
PIPKEROPS_TOKEN_FILE=/etc/pipkerops/enrollment.token
PIPKEROPS_NAME=linux-node-01
PIPKEROPS_STATE_DIR=/var/lib/pipkerops-agent
PIPKEROPS_CA=/etc/pipkerops/ca.pem
