{
  "name": "pipkerops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "gateway": "tsx --env-file=.env src/server/gateway.ts",
    "worker": "tsx --env-file=.env src/server/worker.ts",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "bootstrap": "tsx --env-file=.env scripts/bootstrap.ts",
    "pki:init": "tsx --env-file=.env scripts/pki.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --env-file=.env --test tests/platform.integration.ts",
    "lint": "eslint .",
    "test:linux": "tsx --env-file=.env --test tests/linux.integration.ts",
    "test:systemd": "tsx --env-file=.env --test tests/systemd.integration.ts",
    "test:connectivity": "tsx --env-file=.env --test tests/connectivity.integration.ts",
    "test:alerts": "tsx --env-file=.env --test tests/alerts.integration.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.6",
    "@types/node-forge": "1.3.14",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cron-parser": "5.10.2",
    "dotenv": "18.0.9",
    "lucide-react": "1.63.0",
    "next": "16.4.3",
    "node-forge": "1.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "redis": "6.3.0",
    "swr": "2.5.1",
    "tailwind-merge": "3.7.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  }
}
